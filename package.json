{
  "name": "wa-admin-panel",
  "version": "1.0.0",
  "private": true,
  "description": "Panel admin chat WhatsApp: inbox terpusat realtime + auto-response yang bisa diatur sendiri",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "setup": "prisma generate && prisma db push && node scripts/seed.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "node scripts/seed.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@whiskeysockets/baileys": "^6.7.9",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=20"
  }
}
