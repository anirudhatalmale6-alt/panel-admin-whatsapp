# Contoh konfigurasi Nginx untuk panel admin WhatsApp.
# Simpan sebagai /etc/nginx/sites-available/wa-admin lalu:
#   ln -s /etc/nginx/sites-available/wa-admin /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d panel.domain-anda.com

server {
    listen 80;
    server_name panel.domain-anda.com;

    # Batas ukuran body; webhook Meta kecil, ini lebih dari cukup
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # WAJIB: Socket.IO butuh upgrade ke WebSocket, tanpa dua baris ini
        # pesan masuk tidak akan muncul realtime di panel.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 300s;
    }
}
