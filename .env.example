# ---------------------------------------------------------------------------
# Salin file ini menjadi .env lalu sesuaikan isinya:
#   cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000

# --- Database --------------------------------------------------------------
# SQLite (default, paling gampang — tidak perlu install apa pun):
DATABASE_URL="file:../data/wa-admin.db"
#
# MySQL:
#   1. ubah provider di prisma/schema.prisma menjadi "mysql"
#   2. DATABASE_URL="mysql://user:password@localhost:3306/wa_admin"
#
# PostgreSQL:
#   1. ubah provider di prisma/schema.prisma menjadi "postgresql"
#   2. DATABASE_URL="postgresql://user:password@localhost:5432/wa_admin"
#
# Setelah mengubah, jalankan: npx prisma db push

# --- Keamanan --------------------------------------------------------------
# WAJIB diganti dengan teks acak panjang. Kalau ini bocor, orang lain bisa
# membuat token login palsu. Buat yang acak dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang

# Berapa lama sesi login bertahan (jam)
JWT_TTL_HOURS=168

# Set ke 0 kalau panel dijalankan lewat HTTP biasa tanpa SSL (tidak disarankan)
COOKIE_SECURE=1

# --- Pilih cara terhubung ke WhatsApp --------------------------------------
# mock    = simulasi, untuk demo dan uji coba aturan tanpa nomor WhatsApp
# baileys = nomor WhatsApp biasa / WA Business, login scan QR (open source)
# cloud   = WhatsApp Cloud API resmi dari Meta
WA_PROVIDER=baileys

# --- Kalau WA_PROVIDER=baileys ---------------------------------------------
# Folder tempat sesi login disimpan. BACKUP folder ini supaya tidak perlu
# scan QR ulang setiap kali server dipindah atau di-restore.
BAILEYS_SESSION_DIR=./data/baileys-session

# Set ke 1 kalau mau nomor terlihat "online" terus di WhatsApp
BAILEYS_MARK_ONLINE=0

# --- Kalau WA_PROVIDER=cloud -----------------------------------------------
# Dari Meta Business > WhatsApp > API Setup
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
# Teks bebas buatan sendiri. Harus sama persis dengan yang diisi di kolom
# "Verify token" saat mendaftarkan webhook di Meta.
WA_CLOUD_VERIFY_TOKEN=ganti-juga-yang-ini
WA_CLOUD_API_VERSION=v21.0

# --- Lain-lain -------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Jakarta

# Akun admin pertama, dipakai oleh `npm run seed`
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-password-ini
